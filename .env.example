# Optional: enables LLM-written answers with citations. Without it, the app returns the top passages (extractive mode).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Retrieval backend: "local" (hashed TF-IDF, no downloads) or "dense" (sentence-transformers, pip install sentence-transformers)
EMBEDDER=local

# Optional: Gemini writes the answers (used when ANTHROPIC_API_KEY is not set). Model defaults to gemini-2.5-flash.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional: ElevenLabs reads answers aloud (adds a Listen button). Voice and model are overridable.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_multilingual_v2
